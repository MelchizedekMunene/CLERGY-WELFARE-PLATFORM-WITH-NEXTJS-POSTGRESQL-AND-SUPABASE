// Prisma schema generated from shepherds_welfare_project_plan.csv
// Implements: users, contributions, loans, events

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ContributionType {
  MONTHLY_CONTRIBUTION
  SOCIAL_WELFARE
  SPECIAL
}

enum ContributionStatus {
  PENDING
  PARTIAL
  PAID
}

// Loan entities removed — replaced by group assets/investments

enum EventType {
  MEETING
  PROJECT
  SOCIAL
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  phone             String         @unique
  full_name         String
  role              Role           @default(MEMBER)
  password          String
  church_name       String
  registration_date DateTime
  is_active         Boolean        @default(true)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  contributions     Contribution[]
  registrationFee   RegistrationFee?
  assets            Asset[]
  expectedContributions     ExpectedContribution[]
  expectedContributionsSet  ExpectedContribution[] @relation("ExpectedContributionsSetBy")
  eventsCreated     Event[]        @relation("EventsCreated")
  recordedContribs  Contribution[] @relation("RecordedContributions")
  uploadedDocuments AssetDocument[]
  assetInvestments  AssetInvestment[]
  // Note: removed loan relations; added asset relations below as needed

  @@map("users")
}

model Contribution {
  id                 String           @id @default(uuid()) @db.Uuid
  user_id            String           @db.Uuid
  amount             Decimal          @db.Decimal(10,2)
  expectedAmount     Decimal?         @db.Decimal(10,2)
  contribution_date  DateTime
  contribution_type  ContributionType
  status             ContributionStatus @default(PENDING)
  payment_method     String?
  transaction_ref    String?
  recorded_by        String?          @db.Uuid
  investment_id      String?          @db.Uuid
  notes              String?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  user               User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  recordedBy         User?            @relation("RecordedContributions", fields: [recorded_by], references: [id])
  investment         AssetInvestment? @relation("InvestmentContributions", fields: [investment_id], references: [id])

  @@map("contributions")
}

model RegistrationFee {
  id              String           @id @default(uuid()) @db.Uuid
  user_id         String           @unique @db.Uuid
  expectedAmount  Decimal          @db.Decimal(10,2)
  amountPaid      Decimal          @db.Decimal(10,2) @default(0)
  status          ContributionStatus @default(PAID)
  paidDate        DateTime?
  notes           String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("registration_fees")
}

model Asset {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  purchase_date DateTime?
  purchase_price Decimal?         @db.Decimal(12,2)
  current_value  Decimal?         @db.Decimal(12,2)
  created_by    String            @db.Uuid
  created_at    DateTime          @default(now())

  documents     AssetDocument[]
  investments   AssetInvestment[]
  createdBy     User              @relation(fields: [created_by], references: [id])

  @@map("assets")
}

model ExpectedContribution {
  id                String           @id @default(uuid()) @db.Uuid
  user_id           String           @db.Uuid
  contribution_type ContributionType
  expected_amount   Decimal          @db.Decimal(10,2)
  effective_from    DateTime
  effective_until   DateTime?
  notes             String?
  set_by            String?          @db.Uuid
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  user              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  setBy             User?            @relation("ExpectedContributionsSetBy", fields: [set_by], references: [id])

  @@unique([user_id, contribution_type, effective_from])
  @@index([user_id])
  @@index([contribution_type])
  @@map("expected_contributions")
}

model AssetDocument {
  id          String   @id @default(uuid()) @db.Uuid
  asset_id    String   @db.Uuid
  filename    String
  url         String
  uploaded_by String   @db.Uuid
  is_sensitive Boolean @default(true)
  created_at  DateTime @default(now())

  asset       Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  uploadedBy  User     @relation(fields: [uploaded_by], references: [id])

  @@map("asset_documents")
}

model AssetInvestment {
  id           String        @id @default(uuid()) @db.Uuid
  asset_id     String        @db.Uuid
  total_amount Decimal       @db.Decimal(12,2)
  acquired_at  DateTime
  created_by   String        @db.Uuid
  created_at   DateTime      @default(now())

  asset        Asset         @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  createdBy    User          @relation(fields: [created_by], references: [id])
  contributions Contribution[] @relation("InvestmentContributions")

  @@map("asset_investments")
}

model Event {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  event_date   DateTime
  location     String?
  event_type   EventType?
  created_by   String    @db.Uuid
  is_published Boolean   @default(true)
  created_at   DateTime  @default(now())

  createdBy    User      @relation("EventsCreated", fields: [created_by], references: [id])

  @@map("events")
}

model PasswordReset {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @db.VarChar(255)
  otp_token     String    @db.VarChar(255)
  is_used       Boolean   @default(false)
  expires_at    DateTime
  created_at    DateTime  @default(now())
  verified_at   DateTime?

  @@index([email])
  @@index([otp_token])
  @@index([expires_at])
  @@map("password_resets")
}
